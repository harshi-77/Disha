rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles - strict isolation to document owner
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      // User saved routes & commute telemetry subcollection
      match /savedRoutes/{routeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(routeId);
        allow update: if isOwner(userId) && isValidId(routeId);
        allow delete: if isOwner(userId) && isValidId(routeId);
      }
    }
  }
}

# Comma-separated browser origins. Do not use * in production.
DISHA_CORS_ORIGINS=http://localhost:3000
# Optional Supabase REST persistence. Keep this server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Identifies DISHA to Nominatim. Set a monitored contact address before public deployment.
NOMINATIM_USER_AGENT=DISHA/1.0 (contact: admin@example.com)

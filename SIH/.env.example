# Demo mode keeps auth, routes, traffic, places, incidents, and Ask DISHA usable offline.
VITE_DEMO_MODE=true

# FastAPI base URL. Leave blank when using `npm run dev`; Vite proxies /api
# and /health to the local backend. Set this for a separately deployed API.
VITE_API_URL=

# Optional live provider key. Demo mode does not require Google, Supabase, Gemini,
# or Mapbox credentials and will not call those services.
VITE_GOOGLE_MAPS_API_KEY=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_MAPBOX_ACCESS_TOKEN=
